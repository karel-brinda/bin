#!/usr/bin/env bash
# Pack a directory into a timestamped .tar.xz archive in the current directory.

set -euo pipefail

if [[ $# -ne 1 ]]; then
	printf 'usage: %s DIR\n' "${0##*/}" >&2
	exit 1
fi

dir="${1%/}"

if [[ ! -d "$dir" ]]; then
	printf '%s: not a directory: %s\n' "${0##*/}" "$dir" >&2
	exit 1
fi

parent="$(dirname "$dir")"
name="$(basename "$dir")"
timestamp="$(date '+%Y-%m-%d_%H-%M-%S')"
outfile="${name}__${timestamp}.tar.xz"

tar -C "$parent" -cf - "$name" \
	| xz -9e -T0 -v \
	> "$outfile"

echo "$outfile"
