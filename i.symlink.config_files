#!/usr/bin/env bash
# Symlink the shared dotfiles from ~/bin into the home directory (skips links that already exist).

set -euo pipefail

# $1: path relative to ~/bin, linked at the same path relative to the home directory
link() {
	local target="$HOME/bin/$1"
	local dest="$HOME/$1"

	if [[ -L "$dest" && "$(readlink "$dest")" == "$target" ]]; then
		printf 'already linked: %s\n' "$dest"
	elif [[ -e "$dest" || -L "$dest" ]]; then
		printf 'exists and is not a link to %s: %s\n' "$target" "$dest" >&2
		return 1
	else
		mkdir -p -- "$(dirname "$dest")"
		ln -s -- "$target" "$dest"
		printf 'linked: %s -> %s\n' "$dest" "$target"
	fi
}

status=0
for f in .vimrc .vim .config/nvim/init.vim .tmux.conf .gitconfig; do
	link "$f" || status=1
done
exit "$status"
