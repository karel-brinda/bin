#!/usr/bin/env python3
"""Convert a TSV file (or standard input) to CSV.

The input is plain TSV without quoting; fields are quoted on output when
they contain a comma, a quote, or a line break.
"""

import csv
import sys


def main():
    if len(sys.argv) > 2 or sys.argv[1:] in (["-h"], ["--help"]):
        print("usage: tsv.to_csv [in.tsv]", file=sys.stderr)
        sys.exit(1)

    if len(sys.argv) == 2:
        source = open(sys.argv[1], newline="")
    else:
        source = sys.stdin

    writer = csv.writer(sys.stdout, lineterminator="\n")
    for line in source:
        writer.writerow(line.rstrip("\r\n").split("\t"))


if __name__ == "__main__":
    main()
