#!/usr/bin/env bash

set -euo pipefail

if [[ $# -gt 1 ]]; then
	printf 'usage: %s [directory]\n' "${0##*/}" >&2
	exit 1
fi

if [[ $(uname) != Darwin ]]; then
	printf '%s: macOS is required\n' "${0##*/}" >&2
	exit 1
fi

dir=${1-.}
if [[ ! -d "$dir" ]]; then
	printf '%s: not a directory: %s\n' "${0##*/}" "$dir" >&2
	exit 1
fi

dir=$(CDPATH= cd -P -- "$dir" && pwd -P)
encoded_dir=$(/usr/bin/osascript -l JavaScript -e 'function run(argv) { return encodeURIComponent(argv[0]); }' "$dir")
open "claude://code/new?folder=$encoded_dir"
