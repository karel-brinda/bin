#!/usr/bin/env bash
# Export every committed version of a file, newest first, into a directory (default: a new temporary one).

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
	printf 'usage: %s file [output_dir]\n' "${0##*/}" >&2
	exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
	printf '%s: not a file: %s\n' "${0##*/}" "$file" >&2
	exit 1
fi

# Path relative to the repository root, as required by git cat-file.
path="$(git ls-files --full-name --error-unmatch -- "$file")"
name="${path##*/}"

if [[ $# -eq 2 ]]; then
	outdir="$2"
	mkdir -p "$outdir"
else
	outdir="$(mktemp -d)"
fi

count=0
git log --all --format='%H %ad' --date=short -- "$file" \
	| while read -r hash date; do
		# A commit may also delete the file; skip it then.
		if ! git cat-file -e "$hash:$path" 2>/dev/null; then
			continue
		fi
		count=$((count + 1))
		out="$outdir/$(printf '%04d' "$count").$date.$hash.$name"
		git cat-file -p "$hash:$path" > "$out"
		printf '%s\n' "$out"
	done

printf 'versions stored in %s\n' "$outdir"
