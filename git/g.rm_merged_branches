#!/usr/bin/env bash
# Delete local branches merged into the current branch; main, master, dev and develop are kept.

set -euo pipefail

if [[ $# -ne 0 ]]; then
	printf 'usage: %s\n' "${0##*/}" >&2
	exit 1
fi

# Skip the current branch (*), branches checked out in other worktrees (+),
# and the long-lived branches.
branches="$(git branch --merged | grep -Ev '^[*+]|^[[:space:]]*(main|master|dev|develop)$' || true)"

if [[ -z "$branches" ]]; then
	printf 'no merged branches to delete\n'
	exit 0
fi

printf 'Branches to delete:\n%s\n' "$branches"
read -r -n 1 -p "Are you sure? [y/N] " answer
printf '\n'
if [[ ! "$answer" =~ ^[Yy]$ ]]; then
	exit 1
fi

printf '%s\n' "$branches" | while read -r branch; do
	git branch -d "$branch"
done
