#!/usr/bin/env bash
# Pull all Git repositories below a directory (default: $GITDIR), recursing into directories that are not repositories.

set -euo pipefail

. "$(dirname "$0")/../colors.sh"

case "$#" in
	0)
		td="${GITDIR:?GITDIR is not set}"
		log="$HOME/log_repos_update_errors.log"
		: > "$log"
		;;
	1)
		td="$1"
		log=/dev/null
		;;
	*)
		printf 'update all Git repositories in the specified directory\nusage: %s [directory]\n' "${0##*/}" >&2
		exit 1
		;;
esac

process_dir() {
	local d p orig
	for d in */; do
		[[ -d "$d" ]] || continue
		(
			cd "$d"
			p="$(pwd)"
			printf '\n%b\n' "Entering directory $YELLOW$p$NC"
			if [[ -d .git ]]; then
				orig="$(git remote -v | grep origin | awk '{print $2}' | uniq || true)"
				printf '%b\n' "    repository: $CYAN$orig$NC; going to pull"

				{
					{
						{ git pull --rebase --all || git pull --all || git push || git pull ; } \
							&& printf '%b\n' "    ${GREEN}ok${NC}"
					} 2>&1 \
					|| {
						printf '%b\n' "    ${RED}ERROR:${NC} pulling failed; can try '${LIGHTRED}cd $p && git pull${NC}'"
						printf '%s\n' "$p" >> "$log"
					}
				} \
					| { grep -v "^Fetching" | grep -v "^Already"; } || true
			else
				printf '%b\n' "    not a repository, checking subdirectories..."
				process_dir
			fi
		)
	done
}

cd "$td"
process_dir
