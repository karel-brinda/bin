#!/usr/bin/env bash
# Create a detached worktree of the current branch under ~/git-tmp and copy its path to the clipboard.

set -euo pipefail

t=~$(date +%Y%m%d%H%M%S)
d="$HOME/git-tmp/$t"
mkdir -p "$d"
git worktree add "$d" "$(git symbolic-ref HEAD)"
printf '%s\n' "$d"
printf '%s\n' "$d" | clip 2>/dev/null || true
