#!/usr/bin/env bash
# Open the current GitHub repository (or a part of it) in the browser.

set -euo pipefail

usage() {
	cat <<EOM
usage: ${0##*/} [option]   open the current GitHub repository
       -h     print help
       -c     open current commit
       -b     open current branch
       -d     open current directory in the default branch
       -i     open issues
       -p     open pull requests
       -a     open webpage of the author
       -s     open settings
       -t     open GitHub Actions
       -D     print debugging messages
EOM
}

browse() {
	if [[ $(uname) == Darwin ]]; then
		open "$1"
	else
		xdg-open "$1"
	fi
}

default_branch() {
	local ref
	if ref=$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null); then
		printf '%s\n' "${ref#origin/}"
	elif git show-ref --verify --quiet refs/heads/main; then
		printf 'main\n'
	else
		printf 'master\n'
	fi
}

what=root
debug=0

while getopts "bschdatipD" opt; do
	case $opt in
	i) what=issues ;;
	p) what=pullreq ;;
	b) what=branch ;;
	c) what=commit ;;
	t) what=actions ;;
	d) what=directory ;;
	a) what=author ;;
	s) what=settings ;;
	h) usage; exit 0 ;;
	D) debug=1 ;;
	\?) usage >&2; exit 1 ;;
	esac
done

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
	browse "https://github.com"
	exit 0
fi

url=$(git remote -v | grep fetch | awk '{print $2}' | head -n 1)

base=$(printf '%s\n' "$url" \
	| perl -pe 's/^(ssh|git|http|https):\/\///g' \
	| perl -pe 's/^.*\@//g' \
	| perl -pe 's/:/\//g' \
	| perl -pe 's/\.git$//g')

http="https://$base"

repo=$(printf '%s\n' "$base" | perl -pe 's/^.*?\///g')
author="${repo%%/*}"
branch=$(git rev-parse --abbrev-ref HEAD)
commit=$(git rev-parse HEAD)
p=$(pwd -P)
toplevel=$(git rev-parse --show-toplevel)
rel="${p#"$toplevel"}"
rel="${rel#/}"

# Detached HEAD: there is no branch to open.
if [[ "$branch" == HEAD && "$what" == branch ]]; then
	what=commit
fi

if [[ $debug -eq 1 ]]; then
	echo "Repo URL:         $url"
	echo "Base:             $base"
	echo "HTTP address:     $http"
	echo "Repo:             $repo"
	echo "Author:           $author"
	echo "Current branch:   $branch"
	echo "Default branch:   $(default_branch)"
	echo "Commit:           $commit"
	echo "Path:             $p"
	echo "Git toplevel:     $toplevel"
	echo "Rel path:         $rel"
	exit 0
fi

case "$what" in
	root) browse "$http" ;;
	pullreq) browse "$http/pulls" ;;
	issues) browse "$http/issues" ;;
	settings) browse "$http/settings" ;;
	branch) browse "$http/tree/$branch/$rel" ;;
	directory) browse "$http/tree/$(default_branch)/$rel" ;;
	author) browse "https://github.com/$author" ;;
	actions) browse "$http/actions" ;;
	commit) browse "$http/tree/$commit/$rel" ;;
esac
