#!/usr/bin/env bash
# Print a shell script that recreates the Git clones and symlinks found below a directory (default: $GITDIR).

set -euo pipefail

if [[ $# -gt 1 ]]; then
	printf 'usage: %s [dir]\n' "${0##*/}" >&2
	exit 1
fi

# Physical home directory: the paths below come from pwd -P and readlink, so they
# do not start with $HOME when it is a symlink (common on clusters).
home="$(cd "$HOME" && pwd -P)"

# Quote a path for the generated script, writing paths below the home directory
# as ~/... so that the script works from any directory and on any machine.
# shellcheck disable=SC2088  # the ~ is meant for the generated script
q() {
	case "$1" in
		"$home"/*) printf '~/%q' "${1#"$home"/}" ;;
		"$HOME"/*) printf '~/%q' "${1#"$HOME"/}" ;;
		*) printf '%q' "$1" ;;
	esac
}

process_dir() {
	local d target repo
	for d in "$1"/*/; do
		d="${d%/}"
		if [[ -L "$d" ]]; then
			target="$(readlink "$d")"
			printf 'mkdir -p %s && ln -s %s %s\n' "$(q "$(dirname "$d")")" "$(q "$target")" "$(q "$d")"
		elif [[ -d "$d/.git" ]]; then
			repo="$(cd "$d" && git config --get remote.origin.url || true)"
			if [[ -z "$repo" ]]; then
				printf '# no origin remote: %s\n' "$d"
			else
				printf 'mkdir -p %s && git clone --recursive %q %s\n' "$(q "$d")" "$repo" "$(q "$d")"
			fi
		elif [[ -d "$d" ]]; then
			process_dir "$d"
		fi
	done
}

if [[ $# -eq 0 ]]; then
	printf '#!/usr/bin/env bash\n'
	top="${GITDIR:-$HOME/git}"
else
	top="$1"
fi

process_dir "$(cd "$top" && pwd -P)"
