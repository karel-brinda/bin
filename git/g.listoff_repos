#!/usr/bin/env bash
# Print a shell script that recreates the Git clones and symlinks found below a directory (default: $GITDIR).

set -euo pipefail

if [[ $# -gt 1 ]]; then
	printf 'usage: %s [dir]\n' "${0##*/}" >&2
	exit 1
fi

# Paths in the generated script are relative to $HOME when possible.
rel_home() {
	printf '%s\n' "${1#"$HOME"/}"
}

process_dir() {
	local d target repo
	for d in "$1"/*/; do
		d="${d%/}"
		if [[ -L "$d" ]]; then
			target="$(readlink "$d")"
			printf 'mkdir -p %q && ln -s %q %q\n' "$(rel_home "$(dirname "$d")")" "$target" "$(rel_home "$d")"
		elif [[ -d "$d/.git" ]]; then
			repo="$(cd "$d" && git config --get remote.origin.url)"
			printf 'mkdir -p %q && git clone --recursive %q %q\n' "$(rel_home "$d")" "$repo" "$(rel_home "$d")"
		elif [[ -d "$d" ]]; then
			process_dir "$d"
		fi
	done
}

if [[ $# -eq 0 ]]; then
	printf '#!/usr/bin/env bash\n'
	top="${GITDIR:-$HOME/git}"
else
	top="$1"
fi

process_dir "$(cd "$top" && pwd -P)"
