#!/usr/bin/env bash
# Show what git clean -fxd would remove and remove it after confirmation.

set -euo pipefail

if [[ $# -gt 1 ]]; then
	printf 'usage: %s [dir]\n' "${0##*/}" >&2
	exit 1
fi

if [[ $# -eq 1 ]]; then
	cd "$1"
fi

to_remove="$(git clean -fxdn)"

if [[ -z "$to_remove" ]]; then
	printf 'nothing to clean\n'
	exit 0
fi

printf '%s\n' "$to_remove"
read -r -n 1 -p "Remove these files? [y/N] " answer
printf '\n'
if [[ "$answer" =~ ^[Yy]$ ]]; then
	git clean -fxd
fi
