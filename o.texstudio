#!/usr/bin/env bash
# macOS only: open the TeXstudio session files (*.txss2) in the current directory.

set -euo pipefail

if [[ $(uname) != Darwin ]]; then
	printf '%s: macOS is required\n' "${0##*/}" >&2
	exit 1
fi

shopt -s nullglob
sessions=(*.txss2)
shopt -u nullglob

if [[ ${#sessions[@]} -eq 0 ]]; then
	printf '%s: no *.txss2 session file in the current directory\n' "${0##*/}" >&2
	exit 1
fi

open "${sessions[@]}"
