#!/usr/bin/env bash
# Extract pages from a PDF with pdftk, e.g. pdf.extract_pages in.pdf "1-3 7" out.pdf

set -euo pipefail

if [[ $# -ne 3 ]]; then
	printf 'usage: %s in.pdf pages out.pdf\n' "${0##*/}" >&2
	exit 1
fi

if ! command -v pdftk >/dev/null 2>&1; then
	printf '%s: pdftk not found (brew install pdftk-java, or apt-get install pdftk)\n' "${0##*/}" >&2
	exit 1
fi

# The page specification is split on spaces on purpose ("1-3 7" -> 1-3 7).
# shellcheck disable=SC2086
pdftk "$1" cat $2 output "$3"
