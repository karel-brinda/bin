#!/usr/bin/env bash
# Install the usual conda packages into the current environment with mamba.

set -o verbose

packages=(
	# editors
	neovim
	# workflow managers
	snakemake
	# programming & plotting
	pandas xopen numpy ete3 markdown biopython
	jupyterlab bash_kernel
	pylint yapf
	# data downloaders
	sra-tools
	# biodata manipulation
	samtools seqtk
	# alignment
	bwa bowtie2 minimap2 blast
	# my tools
	ococo prophasm prophex
	# de Bruijn graphs
	mccortex bcalm
	# phylogenetics
	mashtree
)

mamba install -y "${packages[@]}"
