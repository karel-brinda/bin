#!/usr/bin/env bash
# Normalize a PDF in place by converting it to PostScript and back.

set -euo pipefail

if [[ $# -ne 1 ]]; then
	printf 'usage: %s file.pdf\n' "${0##*/}" >&2
	exit 1
fi

d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT

pdf2ps "$1" "$d/tmp.ps"
ps2pdf "$d/tmp.ps" "$1"
# Alternative: pdftops "$1" "$d/tmp.ps" && pstopdf "$d/tmp.ps" "$1"
