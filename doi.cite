#!/usr/bin/env bash
# Print citations for DOIs as BibTeX or text and copy them to the clipboard.

set -euo pipefail


usage() {
    cat <<EOM
print citations in bibtex or txt
usage: ${0##*/} [-t] DOI...
       -t     print txt instead of bibtext
EOM
}

if [[ $# -eq 0 ]]; then
	usage
	exit 1
fi

format="bibtex"

while getopts "t" opt; do
	case $opt in
	t)
		format="txt"
		;;
	\?)
		echo "Invalid option: -$OPTARG" >&2
		usage
		exit 1
		;;
	esac
done
shift $((OPTIND - 1))


if [[ "$format" == "txt" ]]; then
	i=0
	for x in "$@"; do
		i=$(( $i + 1))
		y=$(curl -s -LH "accept: text/bibliography" "https://doi.org/$x";)
		yy=$(printf '[%d] %s\n' "$i" "$y")
		echo "$yy"
		printf '%s\n' "$yy" | clip 2>/dev/null || true
	done
else
	for x in "$@"; do
		y=$(curl -s -LH "accept: text/bibliography; style=bibtex" "https://doi.org/$x";)
		yy=$(echo "$y" \
			| perl -pe 's/,/,\n/' \
			| perl -pe 's/},/},\n/g' \
			| perl -pe 's/ }/\n}/g' \
			| perl -pe 's/^\s+/\t/g' \
			| perl -pe 's/^\t@/@/g'
		)
					#\
		echo "$yy"
		printf '%s\n' "$yy" | clip 2>/dev/null || true
	done
fi



