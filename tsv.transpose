#!/usr/bin/env bash
# Transpose a TSV (files or standard input).

set -euo pipefail

awk -F '\t' -v OFS='\t' '
{
	for (i = 1; i <= NF; i++) {
		a[NR, i] = $i
	}
}
NF > p { p = NF }
END {
	for (j = 1; j <= p; j++) {
		str = a[1, j]
		for (i = 2; i <= NR; i++) {
			str = str OFS a[i, j]
		}
		print str
	}
}
' "$@"
