#!/usr/bin/env bash

set -euo pipefail

if [[ $# -lt 2 ]]; then
    printf 'usage: %s file1.pdf file2.pdf [file3.pdf ...]\n' "${0##*/}" >&2
    exit 1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT

readonly HASHES="$tmpdir/hashes.tsv"

extract_text_hash() {
    local pdf="$1"

    {
        pdfgrep -h --color=never -e '.' -- "$pdf" || {
            local status="$?"

            # pdfgrep returns 1 when no match is found.
            # For our purposes, that means "empty extractable text", not a crash.
            if [[ "$status" -eq 1 ]]; then
                true
            else
                return "$status"
            fi
        }
    } |
        tr '\r' '\n' |
        sed 's/[[:space:]]\+$//' |
        sha256sum |
        awk '{print $1}'
}

for pdf in "$@"; do
    if [[ ! -f "$pdf" ]]; then
        printf '%s: error: not a file: %s\n' "${0##*/}" "$pdf" >&2
        exit 1
    fi

    hash="$(extract_text_hash "$pdf")" || {
        printf '%s: error: pdfgrep failed on: %s\n' "${0##*/}" "$pdf" >&2
        exit 1
    }

    printf '%s\t%s\n' "$hash" "$pdf" >> "$HASHES"
done

sort "$HASHES" |
awk -F '\t' '
{
    hash = $1
    file = $2

    count[hash]++
    files[hash] = files[hash] "\n  " file
}
END {
    found = 0

    for (hash in count) {
        if (count[hash] > 1) {
            found = 1
            print "DUPLICATE TEXT HASH: " hash
            print files[hash]
            print ""
        }
    }

    if (!found) {
        print "No text duplicates detected."
    }
}
'

