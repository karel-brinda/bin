#!/usr/bin/env bash
#
# mem.top
#
# Aggregate memory usage by process/application name.
#
# macOS:
#   RAM     = RSS: memory currently resident in physical RAM
#   PRIVATE = RPRVT: resident private memory
#   CMPRS   = compressed memory attributed to the process
#
# Linux:
#   RAM     = RSS: memory currently resident in physical RAM
#
# Summed RSS can double-count shared pages between processes.
#

set -euo pipefail
export LC_ALL=C


###############################################################################
# macOS
###############################################################################

macos()
{
    top_tmp=$(mktemp)
    ps_tmp=$(mktemp)

    trap 'rm -f "$top_tmp" "$ps_tmp"' EXIT

    #
    # Use the second sample so CPU usage is measured over an interval.
    #
    top -l 2 -s 1 -ncols 500 \
        -stats pid,cpu,rprvt,cmprs |
    awk '
        /^PID[[:space:]]/ {
            sample++
            next
        }

        sample == 2 && $1 ~ /^[0-9]+$/ {
            print $1 "\t" $2 "\t" $3 "\t" $4
        }
    ' > "$top_tmp"

    #
    # RSS is reported by ps in KiB.
    #
    ps -axo pid=,rss=,comm= > "$ps_tmp"

    awk '
    ###########################################################################
    # Convert top memory values to MiB.
    ###########################################################################

    function mib(x,    u,n) {
        gsub(/[+%]$/, "", x)

        if (x == "" || x == "-" || x == "N/A")
            return 0

        u = substr(x, length(x), 1)
        n = substr(x, 1, length(x)-1) + 0

        if (u == "T") return n * 1024 * 1024
        if (u == "G") return n * 1024
        if (u == "M") return n
        if (u == "K") return n / 1024
        if (u == "B") return n / 1024 / 1024

        return x / 1024 / 1024
    }


    ###########################################################################
    # Normalize a process name.
    #
    # If the executable is inside an application bundle, use the name of the
    # outermost .app bundle. Otherwise use the executable basename.
    ###########################################################################

    function process_name(s,    a,n,i,x) {
        n = split(s, a, "/")

        for (i = 1; i <= n; i++) {
            if (a[i] ~ /\.app$/) {
                x = a[i]
                sub(/\.app$/, "", x)
                return x
            }
        }

        x = a[n]

        sub(/[[:space:]]+Helper([[:space:]].*)?$/, "", x)
        sub(/[[:space:]]+\([^()]*\)$/, "", x)

        return x
    }


    ###########################################################################
    # First input: top statistics indexed by PID.
    ###########################################################################

    NR == FNR {
        pid = $1

        cpu[pid]     = $2
        private[pid] = mib($3)
        cmprs[pid]   = mib($4)

        next
    }


    ###########################################################################
    # Second input: ps statistics.
    ###########################################################################

    {
        pid = $1
        rss = $2

        command = $3
        for (i = 4; i <= NF; i++)
            command = command " " $i

        name = process_name(command)

        if (name == "")
            next

        ram_sum[name] += rss / 1024
        private_sum[name] += private[pid]
        cmprs_sum[name] += cmprs[pid]

        c = cpu[pid]
        gsub(/%/, "", c)
        cpu_sum[name] += c + 0

        count[name]++
    }


    END {
        for (name in ram_sum) {
            printf "%.6f\t%.6f\t%.6f\t%.3f\t%d\t%s\n",
                   ram_sum[name],
                   private_sum[name],
                   cmprs_sum[name],
                   cpu_sum[name],
                   count[name],
                   name
        }
    }
    ' "$top_tmp" "$ps_tmp" |
    sort -t $'\t' -k1,1nr |
    awk -F '\t' '
    BEGIN {
        print "PROCESS\tRAM\tPRIVATE\tCMPRS\t%CPU\tN"
    }

    {
        printf "%s\t%.0fM\t%.0fM\t%.0fM\t%.1f\t%d\n",
               $6, $1, $2, $3, $4, $5
    }
    ' |
    column -t -s $'\t' |
    less -S
}


###############################################################################
# Linux
###############################################################################

linux()
{
    ps -eo rss=,%cpu=,comm= |
    awk '
    function normalize(s) {
        sub(/[[:space:]]+Helper([[:space:]].*)?$/, "", s)
        sub(/[[:space:]]+\([^()]*\)$/, "", s)
        return s
    }

    {
        rss = $1
        cpu = $2

        name = $3
        for (i = 4; i <= NF; i++)
            name = name " " $i

        name = normalize(name)

        if (name == "")
            next

        ram[name] += rss / 1024

        gsub(/%/, "", cpu)
        cpus[name] += cpu + 0

        count[name]++
    }

    END {
        for (name in ram) {
            printf "%.6f\t%.3f\t%d\t%s\n",
                   ram[name],
                   cpus[name],
                   count[name],
                   name
        }
    }
    ' |
    sort -t $'\t' -k1,1nr |
    awk -F '\t' '
    BEGIN {
        print "PROCESS\tRAM\t%CPU\tN"
    }

    {
        printf "%s\t%.0fM\t%.1f\t%d\n",
               $4, $1, $2, $3
    }
    ' |
    column -t -s $'\t' |
    less -S
}


###############################################################################
# Select implementation.
###############################################################################

case "$(uname -s)" in
    Darwin)
        macos
        ;;

    Linux)
        linux
        ;;

    *)
        echo "Unsupported operating system: $(uname -s)" >&2
        exit 1
        ;;
esac
