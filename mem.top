#!/usr/bin/env bash
#
# mem.top - aggregate memory usage by process/application name
#
# macOS:
#   UNCOMP ≈ MEM - CMPRS
#   shows compressed memory separately
#
# Linux:
#   RSS is resident, uncompressed physical memory
#
# Related helper processes such as:
#   Brave Browser Helper (Renderer)
#   Brave Browser Helper (GPU)
# are grouped under:
#   Brave Browser
#

set -euo pipefail

normalize_awk='
function normalize(s) {
    # Generic macOS-style helper-process grouping.
    # No application names are hardcoded.
    sub(/[[:space:]]+Helper.*$/, "", s)
    return s
}
'

macos()
{
    top -l 1 -ncols 400 -stats command,cpu,mem,cmprs |
    awk "
$normalize_awk

function mib(x,    u,n) {
    gsub(/[+%]$/, \"\", x)

    u = substr(x, length(x), 1)
    n = substr(x, 1, length(x)-1) + 0

    if (u == \"T\") return n * 1024 * 1024
    if (u == \"G\") return n * 1024
    if (u == \"M\") return n
    if (u == \"K\") return n / 1024
    if (u == \"B\") return n / 1024 / 1024

    # Fallback: assume bytes.
    return x / 1024 / 1024
}

/^COMMAND[[:space:]]/ {
    started = 1
    next
}

started && NF >= 4 {
    cmprs = \$NF
    mem   = \$(NF-1)
    cpu   = \$(NF-2)

    name = \$1
    for (i = 2; i <= NF-3; i++)
        name = name \" \" \$i

    name = normalize(name)

    m[name] += mib(mem)
    c[name] += mib(cmprs)

    gsub(/%/, \"\", cpu)
    p[name] += cpu + 0

    n[name]++
}

END {
    for (name in m) {
        u = m[name] - c[name]

        # Rounding/accounting can occasionally make this slightly negative.
        if (u < 0)
            u = 0

        printf \"%.6f\\t%.6f\\t%.6f\\t%.3f\\t%d\\t%s\\n\",
               u, m[name], c[name], p[name], n[name], name
    }
}" |
    sort -t $'\t' -k1,1nr |
    awk -F '\t' '
    BEGIN {
        printf "%-36s %10s %10s %10s %8s %5s\n",
               "PROCESS", "UNCOMP", "MEM", "CMPRS", "%CPU", "N"
    }
    {
        printf "%-36s %9.0fM %9.0fM %9.0fM %7.1f %5d\n",
               $6, $1, $2, $3, $4, $5
    }'
}


linux()
{
    ps -eo pid=,rss=,%cpu=,comm= |
    awk "
$normalize_awk

{
    # Columns:
    # PID RSS %CPU COMMAND...
    rss = \$2
    cpu = \$3

    name = \$4
    for (i = 5; i <= NF; i++)
        name = name \" \" \$i

    if (name == \"\")
        next

    name = normalize(name)

    # Linux ps RSS is in KiB.
    r[name] += rss / 1024

    gsub(/%/, \"\", cpu)
    p[name] += cpu + 0

    n[name]++
}

END {
    for (name in r)
        printf \"%.6f\\t%.3f\\t%d\\t%s\\n\",
               r[name], p[name], n[name], name
}" |
    sort -t $'\t' -k1,1nr |
    awk -F '\t' '
    BEGIN {
        printf "%-36s %10s %8s %5s\n",
               "PROCESS", "RSS", "%CPU", "N"
    }
    {
        printf "%-36s %9.0fM %7.1f %5d\n",
               $4, $1, $2, $3
    }'
}


case "$(uname -s)" in
    Darwin)
        macos
        ;;
    Linux)
        linux
        ;;
    *)
        echo "Unsupported operating system: $(uname -s)" >&2
        exit 1
        ;;
esac
