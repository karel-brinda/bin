#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 1 ]]; then
	printf 'usage: %s project_name\n' "${0##*/}" >&2
	exit 1
fi

BASEDIR=$(dirname "$0")
TEMPLATE="$BASEDIR/samples/pypi_project"
export PROJECT_NAME="$1"

cp -a "$TEMPLATE/." .

# Only the files copied from the template are rewritten and renamed;
# pre-existing files in the current directory are left alone.
(cd "$TEMPLATE" && find . -type f -print0) \
	| while IFS= read -r -d '' f; do
		perl -pi -e 's/_NAME_/$ENV{PROJECT_NAME}/g' "$f"
	done

# Deepest paths first, renaming only the last component so parents stay valid.
(cd "$TEMPLATE" && find . -depth -name '*_NAME_*' -print0) \
	| while IFS= read -r -d '' path; do
		dir="${path%/*}"
		base="${path##*/}"
		mv "$path" "$dir/${base//_NAME_/$PROJECT_NAME}"
	done
