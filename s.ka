#!/usr/bin/env bash
# Cancel all my Slurm jobs in the given partition(s) (comma-separated).

set -euo pipefail

if [[ $# -ne 1 ]]; then
	printf 'usage: %s partition[,partition...]\n' "${0##*/}" >&2
	exit 1
fi

jobs=$(squeue -h -u "$USER" -p "$1" -o '%i')

if [[ -z "$jobs" ]]; then
	printf '%s: no jobs in partition %s\n' "${0##*/}" "$1" >&2
	exit 0
fi

# One job id per line; split on purpose.
# shellcheck disable=SC2086
scancel $jobs
