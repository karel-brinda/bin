#!/usr/bin/env bash
# Print file names with their contents and copy the result to the clipboard if possible.

set -euo pipefail

if [[ $# -lt 1 ]]; then
	printf 'usage: %s file...\n' "${0##*/}" >&2
	exit 1
fi

y=$(for x in "$@"; do
	echo "=================================================="
	echo " $x"
	echo "=================================================="
	echo
	cat "$x"
	echo
	echo
	echo
done)

printf '%s\n' "$y"
printf '%s\n' "$y" | clip 2>/dev/null || true
