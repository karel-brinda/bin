#!/usr/bin/env bash
# Remove metadata from a PDF (to make builds reproducible); in place unless out.pdf is given.

set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 ]]; then
	printf 'usage: %s in.pdf [out.pdf]\n' "${0##*/}" >&2
	exit 1
fi

d=$(mktemp -d)
trap 'rm -rf "$d"' EXIT

cp "$1" "$d/1.pdf"
exiftool -all:all= "$d/1.pdf"
qpdf --linearize --deterministic-id "$d/1.pdf" "$d/2.pdf"

cp "$d/2.pdf" "${2:-$1}"
