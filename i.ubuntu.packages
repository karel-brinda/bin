#!/usr/bin/env bash
# Ubuntu only: install the usual packages with apt.
#
# Installed separately: Chrome, Dropbox, Rust (rustup), Linuxbrew (i.brew.linuxbrew).

set -euo pipefail
set -o verbose

sudo apt-get update

# editors
sudo apt-get install -y vim vim-gtk3 neovim emacs

# players
sudo apt-get install -y mplayer vlc

# git
sudo apt-get install -y git git-svn git-lfs

# tex
sudo apt-get install -y lmodern texlive-full latexmk biber texstudio xzdec

# graphical editors
sudo apt-get install -y inkscape gnuplot gimp wkhtmltopdf pdftk

# bats
sudo apt-get install -y bats

# makes
sudo apt-get install -y software-properties-common build-essential cmake autoconf automake autotools-dev

# compilers
sudo apt-get install -y gcc g++ clang

# libraries
sudo apt-get install -y zlib1g-dev libbz2-dev liblzma-dev libboost-all-dev libncurses-dev \
	libcurl4-openssl-dev libcairo2-dev libjpeg-dev

# other langs
sudo apt-get install -y octave golang-go default-jdk

# bioinformatics
sudo apt-get install -y igv

# tools
sudo apt-get install -y tmux htop iotop openssh-server sshfs parallel xdg-utils

# python
sudo apt-get install -y python3 python3-dev python3-pip python3-venv python3-setuptools cython3 \
	python3-numpy python3-biopython python3-pysam snakemake
