#!/usr/bin/env bash
# Install Miniconda and mamba into ~/miniconda (Linux x86_64, macOS Intel and Apple Silicon).

set -euo pipefail

# Pinned installers; all files and their SHA256 checksums are listed at
# https://repo.anaconda.com/miniconda/
# NOTE: Python 3.13 is the latest version supported by Bioconda (as of October 2026)
# https://bioconda.github.io/faqs.html#what-versions-are-supported
# Intel macOS builds stopped at 25.7.0, so that platform pins an older release.
version_linux_x86_64="py313_26.7.1-1"
sha256_linux_x86_64="c26cbbd996d5ada0bec054b49a37fab690e2f91125701e458df6cca73da9482b"
version_macos_arm64="py313_26.7.1-1"
sha256_macos_arm64="689068fd5c3aaeb0137aad1202dd1743d4d8b62cf3b4b487e53787ef8a04feae"
version_macos_x86_64="py313_25.7.0-2"
sha256_macos_x86_64="9c88674b1a839eeb4cff006df397a05ea7d896472318fd84b7070278f9653dc6"


#####################
# 1) SET UP VARIABLES
#####################

echo "Setting up variables"
d="$HOME/miniconda"
bd="$HOME/miniconda_$(date +%s)"
tmpd="$(mktemp -d)"
trap 'rm -rf "$tmpd"' EXIT

conda="$d/bin/conda"
mamba="$d/bin/mamba"

if [[ -f "$conda" && -f "$mamba" ]]; then
	echo
	echo "Both conda and mamba already installed, quitting"
	echo
	exit 0
fi

case "$(uname -s)-$(uname -m)" in
	Linux-x86_64)
		arch="Linux-x86_64"
		version="$version_linux_x86_64"
		sha256="$sha256_linux_x86_64"
		;;
	Darwin-arm64)
		arch="MacOSX-arm64"
		version="$version_macos_arm64"
		sha256="$sha256_macos_arm64"
		;;
	Darwin-x86_64)
		arch="MacOSX-x86_64"
		version="$version_macos_x86_64"
		sha256="$sha256_macos_x86_64"
		;;
	*)
		echo "Unsupported platform: $(uname -s) $(uname -m)" >&2
		exit 1
		;;
esac
url="https://repo.anaconda.com/miniconda/Miniconda3-$version-$arch.sh"
echo "url=$url"

download() {
	if command -v curl >/dev/null 2>&1; then
		curl -fL -o "$2" "$1"
	else
		wget -O "$2" "$1"
	fi
}

sha256_of() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d ' ' -f 1
	else
		shasum -a 256 "$1" | cut -d ' ' -f 1
	fi
}


######################
# 2) INSTALL MINICONDA
######################

if [[ -f "$conda" ]]; then
	echo
	echo "Conda already installed ($conda), skipping"
	echo
else
	if [[ -d "$d" ]]; then
		echo
		echo "Conda directory without conda already exists ($d), moving it to $bd"
		echo
		mv "$d" "$bd"
	fi
	echo
	echo "Installing miniconda"
	echo
	installer="$tmpd/miniconda.sh"
	download "$url" "$installer"
	actual="$(sha256_of "$installer")"
	if [[ "$actual" != "$sha256" ]]; then
		echo "Checksum mismatch for $url" >&2
		echo "expected: $sha256" >&2
		echo "actual:   $actual" >&2
		exit 1
	fi
	bash "$installer" -b -p "$d"
fi


##################
# 3) INSTALL MAMBA
##################

if [[ -f "$mamba" ]]; then
	echo
	echo "Mamba already installed ($mamba), skipping"
	echo
else
	"$conda" install -y mamba
fi


######################
# 4) UPDATE EVERYTHING
######################

## The Python version is fixed by the installer, so no explicit pin is needed here.
"$mamba" update conda -y
#"$mamba" update --all -y
