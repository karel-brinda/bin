#!/usr/bin/env bash
# Show a program's --help (or -h) output in less.

set -euo pipefail

if [[ $# -lt 1 ]]; then
	printf 'usage: %s program [args...]\n' "${0##*/}" >&2
	exit 1
fi

command -v "$1" || {
	printf '%s: program %s is not installed\n' "${0##*/}" "$1" >&2
	exit 1
}

("$@" --help || "$@" -h) 2>&1 | less
