#! /usr/bin/env bash

#set -o verbose
#set -o xtrace

# Homebrew >= 7 asks for confirmation by default; unlike --yes, this variable
# is also safe with older Homebrew versions.
export HOMEBREW_NO_ASK=1

if [[ $(uname) == 'Linux' ]]; then
	#INSTALL="brew install --force-bottle"
	#INSTALL() {
		#brew install $@
	#}
	finished=" "
	# --force-bottle applies only to the named formula, not to the dependencies
	# brew installs for it, so install the dependencies first, one by one.
	INSTALL() {
		for x in "$@"; do
			>&2 echo "=== Checking $x"
			>&2 echo "....... running: brew deps --topological $x"
			for y in $(brew deps --topological "$x") "$x"; do
				if [[ $finished == *" $y "* ]]; then
					>&2 echo "---- Skipping $y (already processed)"
				else
					>&2 echo "---- Installing $y"
					finished="${finished}${y} "
					brew install --force-bottle "$y"
				fi
			done
		done
	}
else
	#INSTALL="brew install"
	INSTALL() {
		>&2 echo "Going to install $*"
		brew install "$@"
	}
fi


######
## GIT
######
INSTALL git


