#! /usr/bin/env bash

#set -o verbose
#set -o xtrace

readonly PROGDIR="$(dirname "$0")"

if [[ $(uname) == 'Linux' ]]; then
	#INSTALL="brew install --force-bottle"
	#INSTALL() {
		#brew install $@
	#}
	f="$PROGDIR/tmp.linuxbrew"
	finished=" "
	# --force-bottle applies only to the named formula, not to the dependencies
	# brew installs for it, so install the dependencies first, one by one.
	INSTALL() {
		for x in "$@"; do
			>&2 echo "=== Checking $x"
			>&2 echo "....... running: brew deps --topological $x"
			for y in $(brew deps --topological "$x") "$x"; do
				if [[ $finished == *" $y "* ]]; then
					>&2 echo "---- Skipping $y (already processed)"
				else
					>&2 echo "---- Installing $y"
					finished="${finished}${y} "
					brew install --force-bottle "$y"
				fi
			done
		done
	}
else
	#INSTALL="brew install"
	INSTALL() {
		>&2 echo "Going to install $*"
		brew install "$@"
	}
fi

export -f INSTALL


