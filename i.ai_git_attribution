#!/usr/bin/env python3
"""Give Claude Code, Codex, and Gemini CLI their own Git author/committer identity.

usage: i.ai_git_attribution [--dry-run] [claude|codex|gemini ...]

Sets GIT_AUTHOR_NAME, GIT_AUTHOR_EMAIL, GIT_COMMITTER_NAME, and
GIT_COMMITTER_EMAIL in each agent's own configuration, so that Git commands the
agent runs commit as that agent and your own identity stays as it is:

  Claude Code   ~/.claude/settings.json    "env" object
  Codex         ~/.codex/config.toml       [shell_environment_policy.set]
  Gemini CLI    ~/.gemini/.env             KEY="value" lines

CLAUDE_CONFIG_DIR, CODEX_HOME, and GEMINI_CLI_HOME relocate these files, as
they do for the agents. Other settings and comments are kept, each changed file
is first copied to FILE.bak.YYYYMMDD-HHMMSS, and running again changes nothing.
Global and repository Git configuration is never touched.

Verify (restart the agents first): ask each agent to run
  git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT
and check that your own terminal still shows your normal identity. After an
agent commits: git log -1 --format='%an <%ae> / %cn <%ce>'

GitHub attribution: GitHub credits a commit to the account that has the commit's
author email as a verified address. The +claude/+codex/+gemini addresses are not
added to any account, so agent commits show as unlinked authors and do not
count in your contribution graph; pull requests and issues you open still do.
"""

import collections
import json
import os
import re
import shutil
import sys
import tempfile
import time

IDENTITIES = collections.OrderedDict([
    ("claude", ("Karel Břinda's Claude", "karel.brinda+claude@gmail.com")),
    ("codex", ("Karel Břinda's Codex", "karel.brinda+codex@gmail.com")),
    ("gemini", ("Karel Břinda's Gemini", "karel.brinda+gemini@gmail.com")),
])

KEYS = ("GIT_AUTHOR_NAME", "GIT_AUTHOR_EMAIL", "GIT_COMMITTER_NAME", "GIT_COMMITTER_EMAIL")


class ConfigError(Exception):
    pass


def git_env(agent):
    name, email = IDENTITIES[agent]
    return collections.OrderedDict(zip(KEYS, (name, email, name, email)))


def config_path(agent):
    home = os.path.expanduser("~")
    if agent == "claude":
        base = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(home, ".claude")
        return os.path.join(base, "settings.json")
    if agent == "codex":
        base = os.environ.get("CODEX_HOME") or os.path.join(home, ".codex")
        return os.path.join(base, "config.toml")
    base = os.environ.get("GEMINI_CLI_HOME") or home
    return os.path.join(base, ".gemini", ".env")


# --- Claude Code: JSON ------------------------------------------------------

def update_claude(text, wanted):
    """Return (new_text, changes) for settings.json content (None if absent)."""
    if text is None or not text.strip():
        data = collections.OrderedDict()
    else:
        try:
            data = json.loads(text, object_pairs_hook=collections.OrderedDict)
        except ValueError as e:
            raise ConfigError("invalid JSON: {}".format(e))
        if not isinstance(data, dict):
            raise ConfigError("top level is not a JSON object")
    env = data.setdefault("env", collections.OrderedDict())
    if not isinstance(env, dict):
        raise ConfigError('"env" is not a JSON object')
    changes = []
    for key, value in wanted.items():
        if env.get(key) != value:
            changes.append((key, env.get(key), value))
            env[key] = value
    if not changes:
        return text, changes
    return json.dumps(data, indent=2, ensure_ascii=False) + "\n", changes


# --- Codex: TOML ------------------------------------------------------------

HEADER_RE = re.compile(r"^\s*\[\[?\s*([^\[\]]+?)\s*\]\]?\s*(#.*)?$")


def toml_str(value):
    out = []
    for ch in value:
        if ch in '"\\':
            out.append("\\" + ch)
        elif ord(ch) < 0x20 or ord(ch) == 0x7F:
            out.append("\\u{:04X}".format(ord(ch)))
        else:
            out.append(ch)
    return '"' + "".join(out) + '"'


def toml_table_name(raw):
    parts = []
    for part in re.split(r"\s*\.\s*", raw.strip()):
        if len(part) >= 2 and part[0] == part[-1] and part[0] in "\"'":
            part = part[1:-1]
        parts.append(part)
    return ".".join(parts)


def toml_tables(lines):
    """Yield (index, table_name) for each header line outside multi-line strings."""
    in_string = None
    for i, line in enumerate(lines):
        if in_string is None:
            m = HEADER_RE.match(line)
            if m:
                yield i, toml_table_name(m.group(1))
                continue
        for delim in re.findall(r'"""|\'\'\'', line):
            if in_string is None:
                in_string = delim
            elif in_string == delim:
                in_string = None


def toml_key_re(key):
    return re.compile(r"^(\s*)(?:{0}|\"{0}\"|'{0}')\s*=\s*(.*)$".format(re.escape(key)))


def update_codex(text, wanted):
    """Return (new_text, changes) for config.toml content (None if absent)."""
    text = text or ""
    lines = text.splitlines(True)
    tables = list(toml_tables(lines))
    bounds = [0] + [i for i, _ in tables] + [len(lines)]
    names = [""] + [name for _, name in tables]

    # Only a [shell_environment_policy.set] table is edited; inline or dotted
    # forms of the same keys are rare and left for manual editing.
    target = None
    for n, name in enumerate(names):
        body = lines[bounds[n] + (1 if n else 0):bounds[n + 1]]
        if name == "shell_environment_policy.set":
            if target is not None:
                raise ConfigError("[shell_environment_policy.set] appears twice")
            target = (bounds[n] + 1, bounds[n + 1])
        dotted = {"": r"shell_environment_policy\s*[.=]",
                  "shell_environment_policy": r"set\s*[.=]"}.get(name)
        if dotted and any(re.match(r"^\s*" + dotted, l) for l in body):
            raise ConfigError("shell_environment_policy.set is written as an inline table "
                              "or dotted keys; move it to a [shell_environment_policy.set] "
                              "table and run again")

    changes = []
    if target is None:
        if lines and not lines[-1].endswith("\n"):
            lines[-1] += "\n"
        if lines and lines[-1].strip():
            lines.append("\n")
        lines.append("[shell_environment_policy.set]\n")
        for key, value in wanted.items():
            lines.append("{} = {}\n".format(key, toml_str(value)))
            changes.append((key, None, value))
        return "".join(lines), changes

    start, end = target
    insert_at = start
    for i in range(start, end):
        stripped = lines[i].strip()
        if stripped and not stripped.startswith("#"):
            insert_at = i + 1
    new_lines = []
    for key, value in wanted.items():
        rendered = "{} = {}\n".format(key, toml_str(value))
        key_re = toml_key_re(key)
        found = False
        for i in range(start, end):
            m = key_re.match(lines[i])
            if not m:
                continue
            found = True
            current = m.group(2).strip()
            if current == toml_str(value) or re.match(re.escape(toml_str(value)) + r"\s*#", current):
                continue
            changes.append((key, current, value))
            lines[i] = m.group(1) + rendered
        if not found:
            changes.append((key, None, value))
            new_lines.append(rendered)
    if insert_at > 0 and not lines[insert_at - 1].endswith("\n"):
        lines[insert_at - 1] += "\n"
    lines[insert_at:insert_at] = new_lines
    if not changes:
        return text, changes
    return "".join(lines), changes


# --- Gemini CLI: .env ------------------------------------------------------

def dotenv_value(raw):
    raw = raw.strip()
    if len(raw) >= 2 and raw[0] == raw[-1] and raw[0] in "\"'`":
        return raw[1:-1]
    return re.sub(r"\s+#.*$", "", raw).strip()


def dotenv_line(prefix, key, value):
    quote = "'" if '"' in value else '"'
    return "{}{}={}{}{}\n".format(prefix, key, quote, value, quote)


def update_gemini(text, wanted):
    """Return (new_text, changes) for .env content (None if absent)."""
    lines = (text or "").splitlines(True)
    changes = []
    for key, value in wanted.items():
        key_re = re.compile(r"^(\s*(?:export\s+)?){}\s*=(.*)$".format(re.escape(key)))
        found = False
        for i, line in enumerate(lines):
            m = key_re.match(line.rstrip("\r\n"))
            if not m:
                continue
            found = True
            current = dotenv_value(m.group(2))
            if current != value:
                changes.append((key, current, value))
                lines[i] = dotenv_line(m.group(1), key, value)
        if not found:
            if lines and not lines[-1].endswith("\n"):
                lines[-1] += "\n"
            changes.append((key, None, value))
            lines.append(dotenv_line("", key, value))
    if not changes:
        return text, changes
    return "".join(lines), changes


UPDATERS = {"claude": update_claude, "codex": update_codex, "gemini": update_gemini}


# --- Files ------------------------------------------------------------------

def read_text(path):
    if not os.path.exists(path):
        return None
    with open(path, encoding="utf-8", newline="") as f:
        return f.read()


def backup(path):
    stamp = time.strftime("%Y%m%d-%H%M%S")
    dest = "{}.bak.{}".format(path, stamp)
    n = 1
    while os.path.exists(dest):
        dest = "{}.bak.{}.{}".format(path, stamp, n)
        n += 1
    shutil.copy2(path, dest)
    return dest


def write_atomic(path, text, new_mode):
    """Replace path's contents, keeping its permissions; follows symlinks."""
    path = os.path.realpath(path)
    directory = os.path.dirname(path)
    if not os.path.isdir(directory):
        os.makedirs(directory, 0o700)
    mode = os.stat(path).st_mode & 0o7777 if os.path.exists(path) else new_mode
    fd, tmp = tempfile.mkstemp(dir=directory, prefix=".tmp.", suffix="." + os.path.basename(path))
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="") as f:
            f.write(text)
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    except BaseException:
        os.unlink(tmp)
        raise


# --- Main -------------------------------------------------------------------

NOTES = {
    "codex": [
        "applies to commands Codex runs; an include filter in [shell_environment_policy] "
        "would remove these variables",
    ],
    "gemini": [
        "loaded only in trusted folders and only when no .env is found first in the "
        "project or its parent directories",
        "never overrides variables already set in the environment that starts gemini",
        "removed from shell commands if security.environmentVariableRedaction.enabled "
        "is true (names containing AUTH); then add the four names to its allowed list",
    ],
}


def describe(value):
    return "(unset)" if value is None else value


def main(argv):
    dry_run = False
    agents = []
    for arg in argv:
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if arg in ("-n", "--dry-run"):
            dry_run = True
        elif arg in IDENTITIES:
            if arg not in agents:
                agents.append(arg)
        else:
            print("usage: i.ai_git_attribution [--dry-run] [claude|codex|gemini ...]",
                  file=sys.stderr)
            return 1
    agents = agents or list(IDENTITIES)

    # Plan every change first, so that one unreadable file leaves all untouched.
    plans = []
    failed = False
    for agent in agents:
        path = config_path(agent)
        try:
            text = read_text(path)
            new_text, changes = UPDATERS[agent](text, git_env(agent))
        except (ConfigError, OSError, UnicodeDecodeError) as e:
            print("error: {}: {}".format(path, e), file=sys.stderr)
            failed = True
            continue
        plans.append((agent, path, text, new_text, changes))
    if failed:
        print("nothing was changed", file=sys.stderr)
        return 1

    prefix = "would " if dry_run else ""
    for agent, path, text, new_text, changes in plans:
        name, email = IDENTITIES[agent]
        print("{}: {} <{}>".format(agent, name, email))
        if not changes:
            print("  unchanged: {}".format(path))
        else:
            if text is None:
                action = "create"
            else:
                action = "update"
                if not dry_run:
                    print("  backup: {}".format(backup(path)))
            if not dry_run:
                write_atomic(path, new_text, 0o600 if agent == "gemini" else 0o644)
            print("  {}{}: {}".format(prefix, action, path))
            for key, old, new in changes:
                print("    {}: {} -> {}".format(key, describe(old), new))
        for note in NOTES.get(agent, []):
            print("  note: {}".format(note))

    shell_vars = [k for k in KEYS if k in os.environ]
    if shell_vars:
        print("\nwarning: this shell already sets {}; agents started from it may inherit "
              "those values".format(", ".join(shell_vars)))

    print("""
Restart the agents, then ask each one to run:
  git var GIT_AUTHOR_IDENT; git var GIT_COMMITTER_IDENT
Your own terminal should still show your normal identity. After an agent commits:
  git log -1 --format='%an <%ae> / %cn <%ce>'""")
    if dry_run:
        print("\ndry run: nothing was written")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
