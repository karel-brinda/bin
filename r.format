#!/usr/bin/env bash
# Reformat an R source file in place with formatR.

set -euo pipefail

if [[ $# -ne 1 ]]; then
	printf 'usage: %s file.R\n' "${0##*/}" >&2
	exit 1
fi

Rscript --vanilla - "$1" <<'RSCRIPT'
#install.packages("formatR", repos = "https://cran.rstudio.com")
library(formatR)

args <- commandArgs(trailingOnly = TRUE)

options(width = 120)

options(formatR.arrow = TRUE)
options(formatR.comment = TRUE)
options(formatR.blank = TRUE)
options(formatR.indent = 3)
options(formatR.brace.newline = FALSE)

tidy_source(args[1], file = args[1])
RSCRIPT
